# Copy this file to .env and replace the placeholder.
# Never commit .env or paste this key into source code.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Optional provider settings.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Comma-separated models tried in order when the preferred one is overloaded.
GEMINI_TEXT_FALLBACKS=gemini-3.5-flash,gemini-3.8-flash
GEMINI_IMAGE_FALLBACKS=
AI_PROVIDER=gemini

# FASHN official API (virtual try-on). Buy credits, then create a key at
# https://app.fashn.ai/api. When this is empty the app falls back to the free
# Hugging Face demo Space.
FASHN_API_KEY=
FASHN_MODEL=tryon-v1.6
# "fashn" renders try-ons with the FASHN API while Gemini keeps writing the
# style advice. Set "gemini" to try Gemini's image model first instead.
TRYON_PROVIDER=fashn

# Bodygram body-measurement scanning (server-side only).
# Create a free account at https://platform.bodygram.com (5 free scans).
BODYGRAM_ORG_ID=
BODYGRAM_API_KEY=

# Meshy image-to-3D (server-side only) for real design 360 views.
# Create a key at https://www.meshy.ai/settings/api
FITVERSE_3D_API_KEY=

# Garment Studio development server (Vitryne web editor).
STUDIO_URL=http://127.0.0.1:5173/
