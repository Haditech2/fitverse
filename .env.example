# Copy this file to .env and replace the placeholder.
# Never commit .env or paste this key into source code.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Optional provider settings.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
AI_PROVIDER=gemini

# Bodygram body-measurement scanning (server-side only).
# Create a free account at https://platform.bodygram.com (5 free scans).
BODYGRAM_ORG_ID=
BODYGRAM_API_KEY=
