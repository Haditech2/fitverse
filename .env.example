# Copy this file to .env and replace the placeholder.
# Never commit .env or paste this key into source code.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Optional provider settings.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Comma-separated models tried in order when the preferred one is overloaded.
GEMINI_TEXT_FALLBACKS=gemini-3.5-flash,gemini-3.8-flash
GEMINI_IMAGE_FALLBACKS=
AI_PROVIDER=gemini

# Bodygram body-measurement scanning (server-side only).
# Create a free account at https://platform.bodygram.com (5 free scans).
BODYGRAM_ORG_ID=
BODYGRAM_API_KEY=

# Meshy image-to-3D (server-side only) for real design 360 views.
# Create a key at https://www.meshy.ai/settings/api
FITVERSE_3D_API_KEY=
